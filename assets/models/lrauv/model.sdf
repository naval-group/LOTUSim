<?xml version="1.0"?>
<sdf version="1.6">
  <model name="lrauv">
    <!-- Body -->
    <link name="base_link">
      <pose>0 0 0 0 0 3.1415</pose>
      <collision name="collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://lrauv/meshes/tethys.dae</uri>
            <submesh>
              <name>Body</name>
              <center>false</center>
            </submesh>
          </mesh>
        </geometry>
      </collision>
      <sensor name="ais_sensor" type="custom" gz:type="ais">
        <lotusim_power>
          <type>sensor</type>
          <nominal_w>3.0</nominal_w>
          <priority>4</priority>
        </lotusim_power>
        <update_rate>1</update_rate>
        <noise_sigma>0.01</noise_sigma>
        <noise_amplitude>0.01</noise_amplitude>
      </sensor>
      <sensor name="imu_sensor" type="custom" gz:type="imu">
        <lotusim_power>
          <type>sensor</type>
          <nominal_w>3.0</nominal_w>
          <priority>4</priority>
        </lotusim_power>
        <always_on>1</always_on>
        <update_rate>1000.0</update_rate>
      </sensor>
      <!-- ===================== -->
      <!-- DVL                 -->
      <!-- ===================== -->
      <sensor name="dvl_sensor" type="custom" gz:type="dvl">

          <always_on>true</always_on>
          <update_rate>5</update_rate>
          <beam_angle_deg>30</beam_angle_deg>

          <noise>
              <type>gaussian</type>
              <mean>0.0</mean>
              <stddev>0.01</stddev>
          </noise>

          <lotusim_seafloor>
              <png_path>model://seabed/seabed.png</png_path>
              <size_x>1000</size_x>
              <size_y>1000</size_y>
              <min_depth>-50</min_depth>
              <max_depth>0</max_depth>
          </lotusim_seafloor>

          <max_altitude>1000</max_altitude>
      </sensor>
    </link>
    <link name="main_generator">
      <lotusim_power>
        <type>rpm_generator</type>
        <fuel_type>hydrogen</fuel_type>
        <fuel_capacity>0.002</fuel_capacity>      <!--full
        tank size in litres-->
        <fuel_level_start>0.001</fuel_level_start>     <!--how
        much fuel at start-->
        <rated_output_w>5000</rated_output_w>
        <rated_rpm>2000</rated_rpm>
        <efficiency>0.35</efficiency>
        <voltage_nominal>48.0</voltage_nominal>
      </lotusim_power>
    </link>
  </model>
</sdf>