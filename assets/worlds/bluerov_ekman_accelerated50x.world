<?xml version="1.0"?>
<!--
  Accelerated (target 50x real time) variant of bluerov_ekman.world, for the
  mine cross-depth drift experiment (multi-hour drift, run faster than real
  time). Identical to bluerov_ekman.world otherwise: same latitude 47 deg
  (Coriolis parameter the Ekman fit assumes) and max_step_size 0.05 s (the
  validated xdyn integration step). Only real_time_factor differs.

  Unverified before this experiment: whether xdyn-driven ("xdyn": true)
  agents actually reach a high achieved RTF, since max_step_size sets the
  rate of the websocket round trip with xdyn (per bluerov_ekman.world's own
  comment); at RTF 50 / max_step_size 0.05 that is a 1000 Hz round-trip
  target, well above what the accelerated-world precedent (kinematic,
  "xdyn": false agents only, see doc/ACCELERATED_SIMULATION.md) has been
  shown to sustain. Measure the achieved RTF (see that doc, section 4)
  before trusting a full-length run's wall-clock budget.
-->
<sdf version="1.9">
    <world name="energy">
        <light type="directional" name="sun">
            <cast_shadows>true</cast_shadows>
            <pose>0 0 10 0 0 0</pose>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
            <attenuation>
                <range>1000</range>
                <constant>0.9</constant>
                <linear>0.01</linear>
                <quadratic>0.001</quadratic>
            </attenuation>
            <direction>-0.5 0.1 -0.9</direction>
        </light>
        <scene>
            <ambient>1.0 1.0 1.0</ambient>
            <background>0.8 0.8 0.8</background>
            <grid>1</grid>
        </scene>
        <gravity>0 0 0</gravity>
        <physics type="ode">
            <max_step_size>0.05</max_step_size>
            <real_time_factor>50</real_time_factor>
        </physics>

        <spherical_coordinates>
            <surface_model>EARTH_WGS84</surface_model>
            <world_frame_orientation>ENU</world_frame_orientation>
            <latitude_deg>47.0</latitude_deg>
            <longitude_deg>-4.195226666666667</longitude_deg>
            <elevation>0</elevation>
            <heading_deg>0</heading_deg>
        </spherical_coordinates>

        <!-- Core Plugins -->
        <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors" />
        <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu" />
        <plugin filename="gz-sim-magnetometer-system" name="gz::sim::systems::Magnetometer" />
        <plugin filename="gz-sim-air-pressure-system" name="gz::sim::systems::AirPressure" />
        <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />

        <plugin filename="physics_interface_plugin" name="lotusim::gazebo::PhysicsInterfacePlugin">
        </plugin>

        <plugin filename="lotusim_sensor_plugin" name="lotusim::sensor::LotusimSensorPlugin">
        </plugin>

        <plugin filename="aerial_demo_mas" name="lotusim::gazebo::AerialMAS">
            <aerial_namespace>aerialWorld</aerial_namespace>
        </plugin>

        <plugin filename="render_plugin" name="lotusim::gazebo::RenderPlugin">
            <connection_protocol>ROS2</connection_protocol>
        </plugin>

        <plugin filename="waypoint_plugin" name="lotusim::gazebo::WaypointFollowerPlugin" />

    </world>
</sdf>
